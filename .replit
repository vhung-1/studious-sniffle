# Replit configuration — runs the Kalshi Intel dashboard in kalshi-intel/.
# Step-by-step setup is in kalshi-intel/REPLIT.md. The Run button uses
# kalshi-intel/replit-run.sh, which provisions the DB and launches everything.

run = "bash kalshi-intel/replit-run.sh"
entrypoint = "kalshi-intel/REPLIT.md"
modules = ["nodejs-20"]

[nix]
channel = "stable-24_11"

[env]
NEXT_TELEMETRY_DISABLED = "1"

[[ports]]
localPort = 3000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "cd kalshi-intel && npm install && npx prisma generate && npm run build"]
run = ["sh", "-c", "cd kalshi-intel && npx prisma migrate deploy && npx next start -H 0.0.0.0 -p 3000"]
