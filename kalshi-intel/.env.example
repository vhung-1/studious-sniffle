# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://kalshi:kalshi@localhost:5432/kalshi_intel?schema=public"

# Kalshi public trade API. The trades endpoint requires no auth.
KALSHI_API_BASE="https://api.elections.kalshi.com/trade-api/v2"

# Ingestion tuning.
INGEST_INTERVAL_MS=10000     # poll cadence for the continuous ingester
INGEST_PAGE_LIMIT=1000       # trades per Kalshi page (max 1000)
INGEST_OVERLAP_SEC=120       # re-scan window to avoid missing trades at the edge
